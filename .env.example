# Chỉ chứa TÊN biến và giá trị giả. Không bao giờ điền khoá thật vào file này.
# Frontend (web/.env) chỉ dùng hai biến VITE_* bên dưới.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Edge Functions — đặt bằng `supabase secrets set`, KHÔNG đưa vào frontend.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY được Supabase tự cấp cho function.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=__server_only__
SERPER_API_KEY=__server_only__
YOUTUBE_API_KEY=__server_only__

# Tuỳ chọn: trần cứng hạn mức ngày (ghi đè xuống nếu nhỏ hơn giá trị trong bảng settings)
DAILY_SERPER_LIMIT=
DAILY_YT_UNITS_LIMIT=
